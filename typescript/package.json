{
  "name": "amdy",
  "version": "0.1.0",
  "description": "TypeScript SDK for the AMDY Answering Machine Detection API (REST control surface + WebSocket detection stream).",
  "license": "MIT",
  "homepage": "https://amdy.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikvb/amdy-api-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/nikvb/amdy-api-sdks/issues"
  },
  "keywords": [
    "amdy",
    "amd",
    "answering-machine-detection",
    "telephony",
    "dialer"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
